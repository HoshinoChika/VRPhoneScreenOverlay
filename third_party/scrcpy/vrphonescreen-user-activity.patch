+    private void guardedWake() {
+        int targetDisplayId = getActionDisplayId();
+        if (targetDisplayId == Device.DISPLAY_ID_NONE) {
+            return;
+        }
+        GuardedWake.apply(new GuardedWake.DeviceAccess() {
+            @Override
+            public boolean isInteractive() {
+                // PowerManager interaction state, not the physical panel power mode.
+                return Device.isScreenOn(targetDisplayId);
+            }
+
+            @Override
+            public void wakeUp() {
+                // Bypass injectKeycode(): it schedules an unconditional delayed off
+                // which could fire after the user has already disabled screen guard.
+                Device.pressReleaseKeycode(KeyEvent.KEYCODE_WAKEUP, targetDisplayId, Device.INJECT_MODE_ASYNC);
+            }
+
+            @Override
+            public void keepActive() {
+                Device.keepActive(targetDisplayId);
+            }
+
+            @Override
+            public void keepDisplayOff() {
+                Controller.this.setDisplayPower(false);
+            }
+        });
+    }
