+    @Test
+    public void testParseGuardedWakeEvent() throws IOException {
+        ByteArrayInputStream bis = new ByteArrayInputStream(new byte[]{(byte) ControlMessage.TYPE_GUARDED_WAKE});
+        ControlMessage event = new ControlMessageReader(bis).read();
+        Assert.assertEquals(128, event.getType());
+        Assert.assertEquals(-1, bis.read());
+    }
+
+    @Test
+    public void testParseUserActivityEvent() throws IOException {
+        ByteArrayInputStream bis = new ByteArrayInputStream(new byte[]{ControlMessage.TYPE_USER_ACTIVITY});
+        ControlMessageReader reader = new ControlMessageReader(bis);
+
+        ControlMessage event = reader.read();
+        Assert.assertEquals(ControlMessage.TYPE_USER_ACTIVITY, event.getType());
+
diff --git a/server/src/test/java/com/genymobile/scrcpy/control/GuardedWakeTest.java b/server/src/test/java/com/genymobile/scrcpy/control/GuardedWakeTest.java
