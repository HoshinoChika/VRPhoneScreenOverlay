--- /dev/null
+++ b/server/src/main/java/com/genymobile/scrcpy/control/GuardedWake.java
@@ -0,0 +1,26 @@
+package com.genymobile.scrcpy.control;
+
+// Runs only for an explicit VR wake request on the existing control thread.
+// No timer, thread, queue or unconditional physical-panel-on request is added.
+final class GuardedWake {
+    interface DeviceAccess {
+        boolean isInteractive();
+        void wakeUp();
+        void keepActive();
+        void keepDisplayOff();
+    }
+
+    private GuardedWake() {
+    }
+
+    static void apply(DeviceAccess device) {
+        try {
+            if (!device.isInteractive()) {
+                device.wakeUp();
+            }
+            device.keepActive();
+        } finally {
+            device.keepDisplayOff();
+        }
+    }
+}
