--- /dev/null
+++ b/server/src/test/java/com/genymobile/scrcpy/control/GuardedWakeTest.java
@@ -0,0 +1,76 @@
+package com.genymobile.scrcpy.control;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public class GuardedWakeTest {
+    @Test
+    public void interactiveDeviceWithPanelOffNeverWakesOrLightsAcrossRepeatedGrabs() {
+        FakeDevice device = new FakeDevice(true);
+        for (int grab = 0; grab < 4; ++grab) {
+            device.events.clear();
+            GuardedWake.apply(device);
+            Assert.assertEquals(Arrays.asList("activity", "off"), device.events);
+            Assert.assertFalse(device.panelOn);
+        }
+    }
+
+    @Test
+    public void sleepingDeviceStillReceivesWakeAndReturnsToPanelOff() {
+        FakeDevice device = new FakeDevice(false);
+        GuardedWake.apply(device);
+        Assert.assertEquals(Arrays.asList("wake", "activity", "off"), device.events);
+        Assert.assertTrue(device.interactive);
+        Assert.assertFalse(device.panelOn);
+    }
+
+    @Test
+    public void unexpectedProbeFailureStillReassertsPanelOff() {
+        FakeDevice device = new FakeDevice(true) {
+            @Override
+            public boolean isInteractive() {
+                throw new IllegalStateException("probe failed");
+            }
+        };
+        Assert.assertThrows(IllegalStateException.class, () -> GuardedWake.apply(device));
+        Assert.assertEquals(Arrays.asList("off"), device.events);
+        Assert.assertFalse(device.panelOn);
+    }
+
+    private static class FakeDevice implements GuardedWake.DeviceAccess {
+        private boolean interactive;
+        private boolean panelOn;
+        private final List<String> events = new ArrayList<>();
+
+        FakeDevice(boolean awake) {
+            interactive = awake;
+        }
+
+        @Override
+        public boolean isInteractive() {
+            return interactive;
+        }
+
+        @Override
+        public void wakeUp() {
+            events.add("wake");
+            interactive = true;
+            panelOn = true;
+        }
+
+        @Override
+        public void keepActive() {
+            events.add("activity");
+        }
+
+        @Override
+        public void keepDisplayOff() {
+            events.add("off");
+            panelOn = false;
+        }
+    }
+}
